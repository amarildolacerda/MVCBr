procedure TestTControllerFactory.SetUp;
begin
  FControllerFactory := TControllerFactory.Create;
  FControllerFactory.add(TMVCBr.InvokeCreate<ITestModel1>(TTestModel1)
    .ID('teste.model'));
  FControllerFactory.View( TTestView.Create   );
